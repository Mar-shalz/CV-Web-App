# Supabase (Project settings > API). Leave empty locally to use preview mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key: back office only, server only, never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# 32 random bytes, base64. Generate: openssl rand -base64 32
SENSITIVE_DATA_KEY_V1=

# PostHog EU project key (optional). Salt for hashing user ids before analytics.
POSTHOG_KEY=
ANALYTICS_SALT=

# AI providers, tried in this order (D-068). Gemini first while testing on its free tier:
# key from https://aistudio.google.com/apikey (server only, never NEXT_PUBLIC).
GEMINI_API_KEY=
# Optional model overrides. Defaults: gemini-3.8-flash (judgement), gemini-3.5-flash-lite (reading).
GEMINI_MODEL=
GEMINI_FAST_MODEL=
# Set to "paid" once Gemini billing is on (free tier calls are logged at no cost).
GEMINI_TIER=
# Order of providers. Default: gemini,anthropic
AI_PROVIDERS=
# Anthropic API key for lib/ai (server only, never NEXT_PUBLIC). Used when Gemini isn't set or fails.
ANTHROPIC_API_KEY=
# Testing on a small budget: "haiku" runs every AI task on the cheapest model. Leave empty in production.
AI_BUDGET_MODE=

# Sentry (optional). No DSN = error tracking off. Use an EU (de.sentry.io) project.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload at build time (CI or Vercel only). Leave empty locally.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Paystack secret key (server only). Use sk_test_ until launch. The webhook URL to set
# in the Paystack dashboard: https://YOUR_DOMAIN/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# Public address of the app, used for the Paystack callback. Example: https://app.example.com
APP_URL=

# Random string Vercel sends to the daily cron (No reply after 30 days). openssl rand -hex 32
CRON_SECRET=

# Speech to text provider for voice answers, chosen after the G4 benchmark. Empty = typed answers only.
SPEECH_PROVIDER=
